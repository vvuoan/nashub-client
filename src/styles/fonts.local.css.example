/* 本地字体声明（苹果专有字体，不随仓库分发）。
 *
 * 这个文件被 .gitignore 忽略，只存在于本机；新克隆需要自备字体后从
 * fonts.local.css.example 复制并改名。缺失时应用自动回退到系统字体栈。
 */
@font-face {
  font-family: "Nastv SF Pro Display";
  src: url("../fonts/sf-pro-display/SF-Pro-Display-Light.woff2") format("woff2");
  font-weight: 300;
  font-style: normal;
  font-display: swap;
  unicode-range: U+0020-007E, U+00A0-024F, U+1E00-1EFF, U+20A0-20CF, U+2100-214F, U+2190-21FF, U+2200-22FF, U+25A0-25FF, U+2600-26FF;
}

@font-face {
  font-family: "Nastv SF Pro Display";
  src: url("../fonts/sf-pro-display/SF-Pro-Display-Regular.woff2") format("woff2");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
  unicode-range: U+0020-007E, U+00A0-024F, U+1E00-1EFF, U+20A0-20CF, U+2100-214F, U+2190-21FF, U+2200-22FF, U+25A0-25FF, U+2600-26FF;
}

